    {
      "id": "account.sessions.list",
      "requestSchema": {
        "type": "object",
        "properties": {
          "includeTrustedDevices": {
            "type": "boolean"
          }
        },
        "required": [
          "includeTrustedDevices"
        ],
        "additionalProperties": false
      },
      "responseSchema": {
        "$ref": "#/types/API6ESessions"
      },
      "events": [],
      "wire": {
        "status": "source_candidate",
        "method": "GET",
        "pathTemplate": "/backend-api/accounts/sessions?include_trusted_devices=true"
      },
      "notes": "False omits the query flag. Bounded200 devices/32 apps; nullable missing metadata remains unknown. Revocation identifiers stay private; opaque catalogue/target UUIDs expire after5min. No raw client URI, auth token, session ID or device hash becomes public."
    },
    {
      "id": "account.sessions.revoke",
      "requestSchema": {
        "type": "object",
        "properties": {
          "operationId": {
            "type": "string",
            "minLength": 36,
            "maxLength": 36
          },
          "catalogId": {
            "type": "string",
            "minLength": 36,
            "maxLength": 36
          },
          "targetId": {
            "type": "string",
            "minLength": 36,
            "maxLength": 36
          },
          "confirm": {
            "enum": [
              true
            ]
          }
        },
        "required": [
          "operationId",
          "catalogId",
          "targetId",
          "confirm"
        ],
        "additionalProperties": false
      },
      "responseSchema": {
        "$ref": "#/types/API6EReceipt"
      },
      "events": [],
      "wire": {
        "status": "source_candidate",
        "method": "POST",
        "pathTemplate": "/backend-api/accounts/{sessions/revoke,trusted_devices/revoke}"
      },
      "notes": "Fresh identity-bound list preflight; refuse current/unavailable rows. Active sessions send session_id; signed-out trusted devices satisfying source can_untrust guard send device_id_hash. One attempt, durable sanitized fingerprints, no retries or optimistic success."
    },
    {
      "id": "account.sessions.revokeAll",
      "requestSchema": {
        "type": "object",
        "properties": {
          "operationId": {
            "type": "string",
            "minLength": 36,
            "maxLength": 36
          },
          "confirmRevokeAllSessions": {
            "enum": [
              true
            ]
          }
        },
        "required": [
          "operationId",
          "confirmRevokeAllSessions"
        ],
        "additionalProperties": false
      },
      "responseSchema": {
        "$ref": "#/types/API6EReceipt"
      },
      "events": [],
      "wire": {
        "status": "source_candidate",
        "method": "POST",
        "pathTemplate": "/backend-api/accounts/logout_all"
      },
      "notes": "Includes current device. Fresh owner/account binding, read preflight and one journaled POST. Concrete private network invalidates only the matching old local WebSession after delivering acknowledgement, preserving reentrant replacement login. Propagated global revocation is not claimed verified."
    },
    {
      "id": "account.sessions.reconcile",
      "requestSchema": {
        "type": "object",
        "properties": {
          "operationId": {
            "type": "string",
            "minLength": 36,
            "maxLength": 36
          }
        },
        "required": [
          "operationId"
        ],
        "additionalProperties": false
      },
      "responseSchema": {
        "$ref": "#/types/API6EReceipt"
      },
      "events": [],
      "wire": {
        "status": "source_candidate",
        "method": "GET",
        "pathTemplate": "/backend-api/accounts/sessions?include_trusted_devices=true"
      },
      "notes": "Read-only absence verification for a previously attempted single session or device-trust revocation. Scoped fingerprints survive restart; never replay a write. All-session global revocation cannot be proven from a current list and remains uncertain."
    }
